{
  "name": "Gatito Finanzas",
  "short_name": "Gatito",
  "description": "Reparte cada pago de Gatito Shop entre banco, publicidad, gastos, sueldo y ahorro.",
  "lang": "es-MX",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f2f4f7",
  "theme_color": "#1c2433",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "reporte", "accept": ["application/pdf", ".pdf"] }]
    }
  }
}
