# Copia este archivo como .env.local y llena tus datos de Supabase
# (Project Settings → Data API). Sin estas variables, la app guarda todo en el dispositivo.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Solo la llave "anon" (pública). NUNCA pongas aquí la service_role.
VITE_SUPABASE_ANON_KEY=
